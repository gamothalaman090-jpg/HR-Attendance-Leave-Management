# =============================================================================
# HR Leave & Attendance Management System — root .gitignore
# Covers: client-side/ (Vite + React) and server/ (Express + Node)
# =============================================================================

# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
dist-ssr/
build/
*.tsbuildinfo

# --- Environment (never commit secrets; keep examples) ---
!.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test / coverage ---
coverage/
.nyc_output/

# --- Vite / frontend caches ---
.vite/
*.local

# --- IDE / editors ---
.cursor/
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Runtime / temp ---
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
